-- Домашка 2. Больше лямбда-исчисления.
-- Решения пишутся на месте дырок `...`. Проверка: `make check`. Как пишутся термы и проверки — lambda-engine/README.md.
-- Интерпретатор: `make repl`; как им пользоваться — lambda-engine/TUTORIAL.md: раздел 6 (стратегии и зацикливание),
-- раздел 5 (`:decode` печатает числа, пары и списки), разделы 3 и 8 про правку файла и проверку.
-- Уровни: 1.x — обязательные, 2.x — подготовка к очной сессии, 3.x — челлендж. В конце файла — две задачи без автопроверки.
-- Вспомогательные определения можно добавлять рядом с задачей: длинный терм легче читать и отлаживать по частям.

language pure
vars x y z


-- ==================================================================
-- Определения с лекций, практик 1–2 и домашки 1. Менять их не нужно.
-- Числа Чёрча записываются цифрами: 3 — это ⌜3⌝ = \s z. s (s (s z)).
-- ==================================================================

I  := \x. x
K  := \x y. x
K' := \x y. y            -- K* с лекции
S  := \x y z. x z (y z)
B  := \f g x. f (g x)
C  := \f x y. f y x

true  := \t e. t
false := \t e. e
if    := \b t e. b t e
not   := \b. if b false true
and   := \a b. if a b false
or    := \a b. if a true b

pair := \x y f. f x y
fst  := \p. p K
snd  := \p. p K'
swap := \p. pair (snd p) (fst p)

natElim := \n s z. n s z
suc     := \n s z. s (natElim n s z)
plus    := \n m. natElim n suc m
mult    := \n m. natElim n (plus m) 0
isZero  := \n. natElim n (K false) true
isEven  := \n. natElim n not true
pred    := \n. fst (natElim n (\p. pair (snd p) (suc (snd p))) (pair 0 0))

-- Комбинатор неподвижной точки: Y F =β F (Y F).
Y := \f. (\x. f (x x)) (\x. f (x x))

-- Варианты по Чёрчу: either F G (inl N) =β F N, either F G (inr M) =β G M.
inl    := \x f g. f x
inr    := \y f g. g y
either := \f g v. v f g

-- Списки Чёрча: [1, 2, 3] = cons 1 (cons 2 (cons 3 nil)); интерпретатор так их и печатает.
-- fold [x1, x2, x3] F Z =β F x1 (F x2 (F x3 Z)).
nil  := \f z. z
cons := \x t f z. f x (t f z)
fold := \xs f z. xs f z


-- ============================================================
-- Уровень 1. Обязательные задачи
-- ============================================================

task 1.1 (предскажите результат)
-- Впишите справа нормальную форму терма слева, сначала в голове и только потом
-- сверяясь с интерпретатором. Пользуйтесь законами (Y, fold, either), а не
-- раскрытием определений.

expect Y (K 5) = ...
expect fold (cons 1 (cons 2 (cons 3 nil))) mult 1 = ...
expect fold (cons 1 (cons 2 (cons 3 nil))) (\x r. x) 0 = ...
expect fold (cons 2 (cons 3 nil)) (\x r. cons (mult x x) r) nil = ...
expect either suc pred (inr 3) = ...


task 1.2 (числа Фибоначчи без рекурсии)
-- Задайте терм fib n без Y: fib 0 = 0, fib 1 = 1, fib 2 = 1, fib 3 = 2, ...
-- Это цикл с фиксированным числом итераций, как факториал из разминки на практике:
-- natElim и состояние в паре.

fib := ...
check fib: normalizing, avoids Y
expect fib 0 = 0
expect fib 1 = 1
expect fib 2 = 1
expect fib 5 = 5
expect fib 7 = 13


task 1.3 (рекурсивная функция: обратный отсчёт)
-- Задайте через Y терм range n, строящий список [n, n-1, ..., 1]; range 0 = [].

range := ...
check range: uses Y
expect range 0 = nil
expect range 1 = cons 1 nil
expect range 3 = cons 3 (cons 2 (cons 1 nil))


task 1.4 (простые функции над списками)
-- Задайте без Y: sum (сумма элементов), length (длина) и map f xs (список из
-- результатов применения f к каждому элементу).

sum := ...
check sum: normalizing, avoids Y
expect sum (cons 1 (cons 2 (cons 3 nil))) = 6
expect sum nil = 0

length := ...
check length: normalizing, avoids Y
expect length (cons 1 (cons 2 nil)) = 2
expect length nil = 0

map := ...
check map: normalizing, avoids Y
expect map suc (cons 1 (cons 2 nil)) = cons 2 (cons 3 nil)
expect map isZero (cons 0 (cons 5 nil)) = cons true (cons false nil)
expect map suc nil = nil


-- ============================================================
-- Уровень 2. Подготовка к очной сессии
-- ============================================================

task 2.1 (арифметика без рекурсии)
-- Задайте сильно нормализуемые термы (без Y): minus, lt, equal.
-- minus n m = k, если plus m k = n, иначе 0; lt n m = true при n < m;
-- equal n m = true при n = m.

minus := ...
check minus: normalizing, avoids Y
expect minus 5 2 = 3
expect minus 2 5 = 0
expect minus 4 4 = 0

lt := ...
check lt: normalizing, avoids Y
expect lt 2 5 = true
expect lt 5 2 = false
expect lt 3 3 = false

equal := ...
check equal: normalizing, avoids Y
expect equal 3 3 = true
expect equal 3 4 = false
expect equal 0 0 = true


task 2.2 (рекурсивные функции: остаток и НОД)
-- Задайте через Y: mod n m — остаток от деления n на m (m > 0), и gcd a b —
-- наибольший общий делитель по алгоритму Евклида (gcd a 0 = a).
-- Пригодятся minus и lt из задачи 2.1.

mod := ...
check mod: uses Y
expect mod 7 3 = 1
expect mod 6 3 = 0
expect mod 2 5 = 2

gcd := ...
check gcd: uses Y
expect gcd 6 4 = 2
expect gcd 7 3 = 1
expect gcd 4 0 = 4


task 2.3 (последний элемент)
-- Задайте без Y терм last, возвращающий последний элемент непустого списка.
-- Подсказка: пусть результат свёртки — вариант: inl — «правее элементов нет»,
-- inr x — «последний элемент уже известен, это x». В конце разберите его через either.

last := ...
check last: normalizing, avoids Y
expect last (cons 1 (cons 2 (cons 3 nil))) = 3
expect last (cons 7 nil) = 7


task 2.4 (пустота и склейка)
-- Задайте без Y: isEmpty xs (true на пустом списке) и concat xs ys (склейка списков).

isEmpty := ...
check isEmpty: normalizing, avoids Y
expect isEmpty nil = true
expect isEmpty (cons 0 nil) = false

concat := ...
check concat: normalizing, avoids Y
expect concat (cons 1 (cons 2 nil)) (cons 3 nil) = cons 1 (cons 2 (cons 3 nil))
expect concat nil (cons 3 nil) = cons 3 nil
expect concat (cons 1 nil) nil = cons 1 nil


task 2.5 (поиск, который может не найти)
-- Как safeHead на практике: неудача — inl, успех — inr.
-- find p xs = inr x, где x — первый элемент списка, для которого p x = true;
-- если такого нет, inl 0. findOr d p xs возвращает найденный элемент или d
-- (разберите результат find с помощью either).

find := ...
expect find isEven (cons 1 (cons 4 (cons 6 nil))) = inr 4
expect find isEven (cons 1 (cons 3 nil)) = inl 0
expect find isEven nil = inl 0

findOr := ...
expect findOr 7 isEven (cons 1 (cons 4 nil)) = 4
expect findOr 7 isEven (cons 1 (cons 3 nil)) = 7


task 2.6 (интерпретатор выражений)
-- Пример со слайда про варианты: вершина выражения — константа, сложение или
-- умножение. Три вида вершин закодированы вложенными вариантами (определения ниже).
-- Задайте eval e, вычисляющий значение выражения: eval (add (num 1) (num 2)) = 3.

num := \n. inl n
add := \a b. inr (inl (pair a b))
mul := \a b. inr (inr (pair a b))

eval := ...
expect eval (num 3) = 3
expect eval (add (num 1) (num 2)) = 3
expect eval (mul (add (num 1) (num 2)) (num 4)) = 12
expect eval (add (mul (num 2) (num 3)) (mul (num 0) (num 5))) = 6


task 2.7 (две стратегии)
-- Дан терм (\x. x x) (K I (I I)). Дважды проредуцируйте его до нормальной формы,
-- расписывая каждый шаг: нормальной стратегией и аппликативной.
-- В цепочках со стратегией имена раскрываются автоматически: каждый ~b~> обязан
-- быть именно тем редексом, который выбирает стратегия.
-- Сравните цепочки: какую работу одна стратегия делает зря, а другая нет? И наоборот?

chain t2_7_normal (strategy normal) =
  (\x. x x) (K I (I I))
  ~b~> ...

chain t2_7_applicative (strategy applicative) =
  (\x. x x) (K I (I I))
  ~b~> ...


task 2.8 (примеры нормальных форм)
-- Приведите примеры замкнутых термов (объяснение выбора — комментарием здесь же):
-- (а) в WHNF, но не в HNF; (б) в HNF, но не в NF.

t2_8a := ...
check t2_8a: closed, whnf, not hnf

t2_8b := ...
check t2_8b: closed, hnf, not nf


-- ============================================================
-- Уровень 3. Челлендж
-- ============================================================

task 3.1 (хвост списка)
-- Задайте без Y терм tail: tail [] = [], tail [5, 10, 13] = [10, 13].

tail := ...
check tail: normalizing, avoids Y
expect tail nil = nil
expect tail (cons 5 (cons 10 (cons 13 nil))) = cons 10 (cons 13 nil)
expect tail (cons 1 nil) = nil


task 3.2 (разворот списка)
-- Задайте без Y терм reverse: reverse [1, 3, 6, 7] = [7, 6, 3, 1].

reverse := ...
check reverse: normalizing, avoids Y
expect reverse (cons 1 (cons 3 (cons 6 (cons 7 nil)))) = cons 7 (cons 6 (cons 3 (cons 1 nil)))
expect reverse nil = nil


-- ============================================================
-- Без автопроверки
-- ============================================================

-- (а) Комбинатор неподвижной точки на любимом языке.
-- В вашем любимом языке рекурсия встроена: достаточно в теле функции вызвать её по
-- имени. А если имени нет — нужна рекурсивная лямбда-функция? Реализуйте комбинатор
-- fix, ИСПОЛЬЗУЯ встроенную в язык рекурсию, и с его помощью задайте факториал в виде
-- factorial = fix (...), где в скобках — нерекурсивная лямбда-функция.
-- Подсказка: свойство fix F M =β F (fix F) M можно читать как определение.
-- Ваш язык энергичный: вспомните первый слайд практики про myif и предпримите меры от
-- зацикливания. В статически типизированном языке задача интереснее: какой тип у fix?
-- Самопроверка: factorial(5) = 120, и в теле factorial нет обращения к имени factorial.

-- (б) Доказательство. Пусть дан терм M. Покажите, как подобрать такой терм N в
-- нормальной форме, что N I =β M. (Для математиков: докажите, что для каждого M
-- существует N в нормальной форме такой, что N I =β M.)
